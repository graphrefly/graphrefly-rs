mod common;
use common::OpRuntime;
use graphrefly_operators::zip;

#[test]
fn diag_producer_storage_after_drop() {
    let rt = OpRuntime::new();
    let s1 = rt.state_int(None);
    let s2 = rt.state_int(None);
    let pack_fn = rt.register_tuple_packer();
    let z = zip(&rt.core, &rt.producer_binding, vec![s1, s2], pack_fn);
    
    {
        let rec = rt.subscribe_recorder(z);
        eprintln!("Inside scope: subscribed");
        let storage = rt.binding.producer_storage().lock();
        eprintln!("Storage entry exists: {}", storage.get(&z).is_some());
        drop(storage);
        eprintln!("About to drop recorder");
        drop(rec);
        eprintln!("Recorder dropped");
    }
    eprintln!("After scope");
    let storage = rt.binding.producer_storage().lock();
    eprintln!("After scope: storage entry exists: {}", storage.get(&z).is_some());
}
