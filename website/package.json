{
	"name": "@graphrefly/rs-docs-site",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.7.0",
	"scripts": {
		"docs:gen": "node scripts/postbuild-rust-starlight-artifact.mjs --rustdoc-only",
		"docs:gen:check": "node scripts/postbuild-rust-starlight-artifact.mjs --rustdoc-only --check",
		"build:starlight-artifact": "astro build && node scripts/postbuild-rust-starlight-artifact.mjs",
		"build:rs-artifact": "pnpm build:starlight-artifact",
		"dev": "astro dev",
		"start": "astro dev",
		"build": "pnpm build:starlight-artifact",
		"preview": "astro preview"
	},
	"dependencies": {
		"@astrojs/starlight": "^0.37.2",
		"astro": "^5.16.0",
		"sharp": "^0.34.5"
	},
	"devDependencies": {
		"typescript": "^5.7.0"
	}
}
